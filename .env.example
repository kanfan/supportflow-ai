SUPPORTFLOW_API_PORT=8000
SUPPORTFLOW_POSTGRES_PORT=5432
SUPPORTFLOW_REDIS_PORT=6379

# Used when the API and worker run directly on the host.
SUPPORTFLOW_DATABASE_URL=postgresql+psycopg://supportflow:supportflow@localhost:5432/supportflow
# Optional: uncomment to enable PostgreSQL integration tests. Use a disposable database only.
# SUPPORTFLOW_TEST_DATABASE_URL=postgresql+psycopg://supportflow:supportflow@localhost:5432/supportflow_test
# Shared browser sessions use this URL with versioned supportflow:ui-session keys.
# Staging/production values are secret references and must use rediss://. The
# application forces certificate and hostname verification; do not use
# ssl_cert_reqs=none/optional or ssl_check_hostname=false.
SUPPORTFLOW_REDIS_URL=redis://localhost:6379/0
SUPPORTFLOW_DEPENDENCY_CONNECT_TIMEOUT_SECONDS=2
# Staging/production Celery URLs also use rediss:// with full certificate
# verification. Keep broker and result namespaces/databases explicit.
SUPPORTFLOW_CELERY_BROKER_URL=redis://localhost:6379/0
SUPPORTFLOW_CELERY_RESULT_BACKEND_URL=redis://localhost:6379/1
SUPPORTFLOW_CELERY_VISIBILITY_TIMEOUT_SECONDS=180

# Local development only. Use a secret manager and a long random value in deployed environments.
SUPPORTFLOW_AUTH_SECRET_KEY=development-only-secret-change-before-production
SUPPORTFLOW_AUTH_ISSUER=supportflow
SUPPORTFLOW_AUTH_AUDIENCE=supportflow-api
SUPPORTFLOW_ACCESS_TOKEN_TTL_MINUTES=15
SUPPORTFLOW_UI_SESSION_TTL_MINUTES=480

# Local development uses private files. Staging uses S3 with the ECS task role.
SUPPORTFLOW_DOCUMENT_STORAGE_MODE=local
SUPPORTFLOW_DOCUMENT_STORAGE_ROOT=.supportflow/documents
# Non-secret S3 settings are supplied by the #37 platform handoff. Do not add access keys.
# SUPPORTFLOW_DOCUMENT_S3_BUCKET=supportflow-staging-documents
# SUPPORTFLOW_DOCUMENT_S3_REGION=eu-central-1
# SUPPORTFLOW_DOCUMENT_S3_ENDPOINT_URL=
SUPPORTFLOW_DOCUMENT_S3_READ_TIMEOUT_SECONDS=30
SUPPORTFLOW_DOCUMENT_S3_TOTAL_MAX_ATTEMPTS=3
SUPPORTFLOW_DOCUMENT_MAX_UPLOAD_BYTES=10485760
# Fake is local/test only; external also requires a concrete adapter at startup.
SUPPORTFLOW_DOCUMENT_SCANNER_MODE=fake
SUPPORTFLOW_DOCUMENT_MAX_PDF_PAGES=250
SUPPORTFLOW_DOCUMENT_MAX_EXTRACTED_CHARACTERS=2000000
SUPPORTFLOW_DOCUMENT_INGESTION_MAX_RETRIES=3
SUPPORTFLOW_DOCUMENT_INGESTION_SOFT_TIME_LIMIT_SECONDS=60
SUPPORTFLOW_DOCUMENT_INGESTION_HARD_TIME_LIMIT_SECONDS=75
